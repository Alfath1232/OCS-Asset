== Tulis /etc/apache2/sites-available/ocsaeon.conf
# OCS AEON — web console di root URL (dikelola repo itcnelita/ocsaeon, task 0012)
<VirtualHost *:80>
    ServerName ocsaeon
    DocumentRoot /usr/share/ocsinventory-reports/ocsreports

    # URL lama /ocsreports -> URL baru di root
    RedirectMatch 301 ^/ocsreports(/(.*))?$ /$2

    <Directory /usr/share/ocsinventory-reports/ocsreports>
        Require all granted
        Options FollowSymLinks
        DirectoryIndex index.php
        AllowOverride Options AuthConfig
        <IfModule mod_php.c>
            php_flag  file_uploads        on
            php_value post_max_size       101M
            php_value upload_max_filesize 100M
        </IfModule>
    </Directory>

    ErrorLog ${APACHE_LOG_DIR}/error.log
    CustomLog ${APACHE_LOG_DIR}/access.log combined
</VirtualHost>
